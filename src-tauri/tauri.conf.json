{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reimagine",
  "version": "0.1.0",
  "identifier": "com.inceptae.reimagine",
  "build": {
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "reimagine",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
