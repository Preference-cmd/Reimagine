# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*

# ----- Node / frontend dependencies -----
node_modules/
ui/package-lock.json

# ----- Build outputs -----
# Cargo workspace (root, src-tauri/, crates/*/ — all caught by unanchored)
target/
**/*.rs.bk

# Vite / Tauri frontend dist
dist/
dist-ssr/
*.local

# Tauri-generated artifacts (regenerated by tauri-build on every build)
src-tauri/gen/

# Tauri Windows MSI bundling scratch dir
src-tauri/WixTools/

# ----- Bundled application binaries (when built ad-hoc outside target/) -----
*.app
*.dSYM
*.dmg
*.deb
*.rpm
*.AppImage
*.msi
*.exe

# ----- Local environment / secrets -----
.env
.env.local
.env.*.local

# ----- Local runtime workspace -----
# Root runtime workspace only: crates/app-host/src/workspace/ is source code.
/workspace/

# ----- Local planning / agent scratch -----
.zcode/
.agents/
.worktrees/
.impeccable/
AGENTS.local.md
CLAUDE.local.md
.sc/
.claude/
.mimocode/

# Project docs: machine-local working memory. Nothing under docs/ is tracked,
# including the generated catalogs (regenerate with scripts/gen-*-catalog.mjs).
docs/

# ----- Local scripts -----
# Machine-local helpers only. .github/scripts/ is tracked: those are the gates.
/scripts/

# Machine-local git hooks, merged into lefthook.yml at run time (proposal tree,
# .agents/): gitignored like the tree it checks, never tracked.
lefthook-local.yml

# ----- Editor / OS -----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
