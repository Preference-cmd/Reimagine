# Frontend lint-staged
cd ui && npx lint-staged

# Rust format check (only on staged .rs files)
# NOTE: match staged .rs paths by grep (not a '*.rs' pathspec) so the check
# stays independent of the cwd changed by the 'cd ui' above.
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -n "$STAGED_RS" ]; then
  echo "Checking Rust formatting on staged files..."
  if ! cargo fmt --all -- --check; then
    echo "❌ Rust formatting check failed. Run 'cargo fmt --all' to fix."
    exit 1
  fi
  echo "✅ Rust formatting OK"
fi
