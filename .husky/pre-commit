#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Frontend lint-staged
cd ui && npx lint-staged

# Rust format check (only on staged .rs files)
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
if [ -n "$STAGED_RS" ]; then
  echo "Checking Rust formatting on staged files..."
  if ! cargo fmt --all -- --check; then
    echo "❌ Rust formatting check failed. Run 'cargo fmt --all' to fix."
    exit 1
  fi
  echo "✅ Rust formatting OK"
fi
